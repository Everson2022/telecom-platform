generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Domain Enums ─────────────────────────────────────────

enum PlanType {
  CONTROL
  PREPAID
  POSTPAID
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum OfferStatus {
  ACTIVE
  INACTIVE
}

enum PriceLocalityStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethodType {
  CARD
  PIX
}

enum FeatureUnit {
  GB
  MIN
  UNIT
}

// ─── Domain Models ─────────────────────────────────────────

model Plan {
  id                    String              @id @default(uuid()) @db.Uuid
  name                  String              @unique @db.VarChar(255)
  type                  PlanType
  maxLines              Int                 @map("max_lines")
  status                PlanStatus          @default(ACTIVE)
  allowedPaymentMethods PaymentMethodType[] @map("allowed_payment_methods")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  features PlanFeature[]
  offers   Offer[]

  @@map("plans")
}

model PlanFeature {
  id        String      @id @default(uuid()) @db.Uuid
  planId    String      @map("plan_id") @db.Uuid
  name      String      @db.VarChar(100)
  quota     Int
  unit      FeatureUnit
  unlimited Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id])

  @@map("plan_features")
}

model Offer {
  id                   String      @id @default(uuid()) @db.Uuid
  planId               String      @map("plan_id") @db.Uuid
  name                 String      @db.VarChar(255)
  basePriceAmountCents Int         @map("base_price_amount_cents")
  basePriceCurrency    String      @default("BRL") @map("base_price_currency") @db.VarChar(3)
  status               OfferStatus @default(ACTIVE)
  validFrom            DateTime    @map("valid_from")
  validUntil           DateTime?   @map("valid_until")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  plan             Plan              @relation(fields: [planId], references: [id])
  eligibilityRules EligibilityRule[]
  localityPrices   PriceLocality[]

  @@map("offers")
}

model EligibilityRule {
  id        String   @id @default(uuid()) @db.Uuid
  offerId   String   @map("offer_id") @db.Uuid
  ruleType  String   @map("rule_type") @db.VarChar(50)
  ruleValue Json     @map("rule_value") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id])

  @@map("eligibility_rules")
}

model PriceLocality {
  id               String              @id @default(uuid()) @db.Uuid
  offerId          String              @map("offer_id") @db.Uuid
  dddCode          String              @map("ddd_code") @db.VarChar(3)
  city             String?             @db.VarChar(100)
  priceAmountCents Int                 @map("price_amount_cents")
  priceCurrency    String              @default("BRL") @map("price_currency") @db.VarChar(3)
  status           PriceLocalityStatus @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([offerId, dddCode, city])
  @@map("price_localities")
}

// ─── Outbox Pattern ────────────────────────────────────────

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateId   String    @map("aggregate_id") @db.VarChar(255)
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  eventType     String    @map("event_type") @db.VarChar(200)
  payload       Json      @db.JsonB
  correlationId String?   @map("correlation_id") @db.VarChar(255)
  causationId   String?   @map("causation_id") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  status        String    @default("PENDING") @db.VarChar(20)
  retryCount    Int       @default(0) @map("retry_count")

  @@index([status, createdAt])
  @@map("outbox_events")
}

// ─── Idempotency ───────────────────────────────────────────

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.VarChar(255)
  eventType   String   @map("event_type") @db.VarChar(200)
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
