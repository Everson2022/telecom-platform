generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillingCycleStatus {
  GENERATED
  PAYMENT_PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum SyncStatus {
  SYNCED
  PENDING
  ERROR
}

model BillingCycle {
  id                   String             @id @default(uuid()) @db.Uuid
  subscriptionId       String             @map("subscription_id") @db.Uuid
  customerId           String             @map("customer_id") @db.Uuid
  cycleStartDate       DateTime           @map("cycle_start_date") @db.Date
  cycleEndDate         DateTime           @map("cycle_end_date") @db.Date
  dueDate              DateTime           @map("due_date") @db.Date
  amountCents          Int                @map("amount_cents")
  currency             String             @default("BRL") @db.VarChar(3)
  status               BillingCycleStatus @default(GENERATED)
  paymentTransactionId String?            @map("payment_transaction_id") @db.Uuid
  invoiceNumber        String             @unique @map("invoice_number") @db.VarChar(50)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([subscriptionId])
  @@index([customerId])
  @@index([status])
  @@map("billing_cycles")
}

model ExternalBillingReference {
  id                String     @id @default(uuid()) @db.Uuid
  subscriptionId    String     @unique @map("subscription_id") @db.Uuid
  externalSystemId  String     @map("external_system_id") @db.VarChar(100)
  externalAccountId String     @map("external_account_id") @db.VarChar(255)
  syncStatus        SyncStatus @default(PENDING)
  lastSyncAt        DateTime?  @map("last_sync_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("external_billing_references")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateId   String    @map("aggregate_id") @db.VarChar(255)
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  eventType     String    @map("event_type") @db.VarChar(200)
  payload       Json      @db.JsonB
  correlationId String?   @map("correlation_id") @db.VarChar(255)
  causationId   String?   @map("causation_id") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  status        String    @default("PENDING") @db.VarChar(20)
  retryCount    Int       @default(0) @map("retry_count")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.VarChar(255)
  eventType   String   @map("event_type") @db.VarChar(200)
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
